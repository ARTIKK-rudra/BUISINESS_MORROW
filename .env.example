# Copy to .env and replace both values before starting the Compose stack.
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
POSTGRES_PASSWORD=replace-with-a-unique-local-database-password
# Optional Twilio Programmable Voice credentials. Keep secrets only in your local .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
