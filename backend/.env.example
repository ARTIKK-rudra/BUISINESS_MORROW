APP_ENV=development
APP_NAME=Morrow API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://morrow:morrow@localhost:5432/morrow
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_MINUTES=30
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
ML_ARTIFACT_DIR=var/models
# Optional Twilio Programmable Voice credentials; never commit real values.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VOICE_CALL_MAX_ATTEMPTS=3
# Safe by default: calls are simulated and logged, never dialed.
VOICE_TEST_MODE=true
# Required together with valid Twilio credentials before real calls can occur.
VOICE_LIVE_CALLS_ENABLED=false
# Provider selection is inert while test mode is enabled. Supported values are
# twilio and exotel; automatic stock alerts remain on the existing Twilio path.
VOICE_PROVIDER=twilio
# Required for live Twilio webhooks. Must be a public HTTPS URL, never localhost.
VOICE_PUBLIC_BASE_URL=
# "gather" is the supported prototype; ConversationRelay additionally requires public WSS setup.
VOICE_TRANSPORT=gather
# Optional Exotel Connect Voice AI credentials. These remain disabled while
# VOICE_TEST_MODE=true and must never be committed with real values.
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_EXOPHONE=
# "in" / "india" / "mumbai" for India, or "sg" / "singapore".
EXOTEL_REGION=in
# Optional Gemini wording layer for verified voice-assistant responses. Never expose this to the frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Maximum wait for Gemini wording or an explicitly user-recorded transcription.
GEMINI_VOICE_TIMEOUT_SECONDS=12
